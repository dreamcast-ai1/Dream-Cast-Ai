# DreamCast AI configuration.
# Copy to .env (scripts/setup.sh does this for you). NEVER commit the real .env file.

# development | production
# These values are for the DEPLOYED backend (Render). For local development use:
#   APP_ENV=development, CORS_ORIGINS=http://localhost:5173, FRONTEND_URL=http://localhost:5173
# (scripts/setup.sh switches a fresh local .env to those values for you.)
APP_ENV=production
# PRODUCTION: a PostgreSQL URL (Render PostgreSQL, Neon, Supabase...), e.g. postgresql://USER:PASSWORD@HOST:5432/DBNAME
# (a "postgres://..." or "postgresql://..." URL is accepted as is; the driver is added automatically).
# LOCAL DEVELOPMENT: leave empty to use the SQLite file backend/dreamcast.db.
# NOTE: SQLite on Render's free disk is wiped on every redeploy, so do not use it in production.
DATABASE_URL=
# Comma-separated exact browser origins allowed to call the API (never "*"). The Netlify site is always allowed too.
CORS_ORIGINS=https://dreamcaastai.netlify.app
PRODUCTION_FRONTEND_URL=https://dreamcaastai.netlify.app
# Behind a proxy (Render) the real client IP is read from X-Forwarded-For. Default: on in production, off locally.
# TRUST_PROXY_HEADERS=true
# Used to build password-reset links.
FRONTEND_URL=https://dreamcaastai.netlify.app

# --- Authentication ---
# local    = email/password handled by this API (works with zero setup)
# supabase = Supabase Auth (adds Google login, email confirmation, emailed password reset)
AUTH_PROVIDER=local
# supabase only: https://<project-ref>.supabase.co
AUTH_URL=
# supabase only: anon / publishable key (public by design, safe for browsers)
AUTH_PUBLIC_KEY=
# local: random string of 32+ characters used to sign login tokens (REQUIRED in production; the app refuses to start without it).
# supabase: the project's JWT secret (only needed for legacy HS256 projects).
# scripts/setup.sh generates a value for you.
AUTH_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Comma-separated emails that receive the ADMIN role when they register/sign in.
ADMIN_EMAILS=

# --- Email (SMTP; server-side only) ---
# Sends the sign-up verification code and password-reset links. Any SMTP service works (Gmail app password, Brevo, Mailgun, Zoho...).
# Without it, sign-up verification and "Forgot password" say that email isn't set up; nothing is pretended and no code is shown.
# EMAIL_PROVIDER=smtp (default) uses the SMTP_* values. Render's free tier BLOCKS outgoing SMTP ports, so there use EMAIL_PROVIDER=brevo
# (sends over HTTPS): create a free Brevo account, verify your sender address, create an API key, and set BREVO_API_KEY.
# SMTP_FROM_EMAIL / SMTP_FROM_NAME are then the verified sender.
EMAIL_PROVIDER=smtp
BREVO_API_KEY=REPLACE_WITH_BREVO_API_KEY
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM_EMAIL=REPLACE_WITH_FROM_EMAIL
SMTP_FROM_NAME=Dream Cast AI
# true = new accounts must enter the 6-digit emailed code before they can sign in (needs SMTP above).
# Accounts that existed before this feature are treated as verified. Set false only if you have no email service yet.
REQUIRE_EMAIL_VERIFICATION=true
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=30

# --- Google sign-in (OAuth; handled by this backend) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI must be exactly GOOGLE_REDIRECT_URI. The client secret stays on the server (never a VITE_ variable).
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://dreamcast-ai-backend.onrender.com/api/auth/google/callback

# --- Storage ---
# local = a folder on this machine (development only). s3 = S3-compatible object storage (production): AWS S3, Cloudflare R2, Backblaze B2,
# Supabase Storage, MinIO. Generated images, videos, thumbnails and movies are stored there; PostgreSQL stores where each file is.
# The bucket must stay PRIVATE. Files are only served by the backend after an ownership check.
STORAGE_BACKEND=local
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
# Only used when STORAGE_BACKEND=s3 (set all four of bucket + the two keys, or the app refuses to start):
S3_BUCKET=REPLACE_WITH_BUCKET_NAME
# "auto" for Cloudflare R2; a real region such as ap-south-1 for AWS S3.
S3_REGION=auto
# Empty for AWS S3. Otherwise the provider's S3 endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET_ACCESS_KEY
# Optional folder inside the bucket, and how bucket names are put in URLs (auto | path | virtual).
S3_PREFIX=
S3_ADDRESSING_STYLE=auto
S3_SIGNED_URL_SECONDS=300

# Auth endpoint rate limit, requests per IP per minute (0 disables).
RATE_LIMIT_AUTH_PER_MINUTE=20

# --- Prompt refinement LLM (server-side only; never sent to the browser) ---
# Any OpenAI-compatible chat API. Free options: groq (https://console.groq.com), gemini (https://aistudio.google.com),
# openrouter (":free" models), or a local ollama. Leave LLM_API_KEY empty and DreamCast still works: it falls back to a
# built-in template for prompt refinement (clearly labelled in the UI).
# groq | gemini | openrouter | ollama | custom
LLM_PROVIDER=groq
LLM_API_KEY=
# Optional overrides (defaults come from the provider preset; model names change over time)
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
# --- Text generation (story, script, lyrics) ---
# Uses the SAME LLM settings as prompt refinement above: one key powers both. Without LLM_API_KEY, story/script/lyrics
# requests are accepted but the job fails with "Text generation provider is not configured."
LLM_GENERATION_TIMEOUT_SECONDS=120
# Hard cap on tokens per generation call (most free tiers allow 4000-8000).
LLM_MAX_OUTPUT_TOKENS=6000
# Max real LLM refinement calls per user per day (0 = unlimited). Beyond it the template is used.
REFINE_DAILY_LIMIT=40
REFINE_RATE_LIMIT_PER_MINUTE=10

# --- Background jobs ---
# true = worker threads run inside the API process (simplest). false = run `python -m app.worker` yourself.
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=2
PROVIDER_POLL_SECONDS=2
JOB_TIMEOUT_SECONDS=900
JOB_MAX_AUTO_RETRIES=1
JOB_RETRY_DELAY_SECONDS=10

# Development simulator: a clearly-labelled FAKE provider so the job pipeline can be tried before real generators exist.
# It never produces real media. It is always off when APP_ENV=production.
ENABLE_DEV_SIMULATOR=false
DEV_SIMULATOR_STEP_SECONDS=1.5

# --- Music generation (external provider; server-side only) ---
# huggingface = MusicGen through the Hugging Face Inference API. Free token: https://huggingface.co/settings/tokens
# Without MUSIC_API_KEY, music requests are accepted but the job fails with a clear "not configured" message (no fake audio).
MUSIC_PROVIDER=huggingface
MUSIC_API_KEY=
MUSIC_MODEL=facebook/musicgen-small
# Optional: override the API base URL (default https://api-inference.huggingface.co/models)
MUSIC_BASE_URL=
# Longest clip this model can produce (10, 20 or 30). DreamCast never requests more than this.
MUSIC_MAX_SECONDS=30
MUSIC_TIMEOUT_SECONDS=240

# --- Voice / text-to-speech (external provider; server-side only) ---
# google = Google Cloud Text-to-Speech (free monthly tier; create an API key with the Text-to-Speech API enabled).
# Supports English (Indian/American/British), Hindi and Telugu, male/female voices. Emotion is approximated by rate/pitch.
VOICE_PROVIDER=google
VOICE_API_KEY=
VOICE_BASE_URL=
VOICE_TIMEOUT_SECONDS=60

# --- Video generation (external provider; server-side only; PAID pay-as-you-go, nothing runs without a key) ---
# fal = fal.ai queue API. Create a key at https://fal.ai/dashboard/keys and add credit; each generated clip is billed by fal.
# Without VIDEO_PROVIDER_API_KEY the app works normally and video requests fail with
# "Video generation is currently unavailable because the video provider has not been configured."
VIDEO_PROVIDER=fal
VIDEO_PROVIDER_API_KEY=REPLACE_WITH_FAL_AI_KEY
# Text-to-video model and image-to-video model (leave the second empty to disable image-to-video)
VIDEO_PROVIDER_MODEL=fal-ai/kling-video/v3/standard/text-to-video
VIDEO_PROVIDER_I2V_MODEL=fal-ai/kling-video/v3/standard/image-to-video
VIDEO_PROVIDER_BASE_URL=
# Longest clip the model can make: 10, 20 or 30. DreamCast never asks for more (Kling v3 makes 3-15 s clips, so keep 10).
# Kling v3 can generate sound at a higher price; false (default) keeps clips cheap.
VIDEO_GENERATE_AUDIO=false
VIDEO_MAX_SECONDS=10
VIDEO_ASPECT_RATIOS=16:9,9:16,1:1
# Seconds between provider status checks (keep at 5-10 to avoid hammering the API)
VIDEO_POLL_SECONDS=8
VIDEO_MAX_DOWNLOAD_MB=300

# --- Image generation (external provider; server-side only; pay-as-you-go, a fraction of a cent per image) ---
# fal.ai text-to-image (default model FLUX schnell, the cheapest). Leave IMAGE_PROVIDER_API_KEY empty to reuse VIDEO_PROVIDER_API_KEY
# (same fal.ai account). Without any key, image requests fail with "Image generation is currently unavailable..." and cost nothing.
IMAGE_PROVIDER=fal
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_MODEL=fal-ai/flux/schnell
IMAGE_PROVIDER_BASE_URL=
IMAGE_POLL_SECONDS=2
IMAGE_MAX_DOWNLOAD_MB=25

# --- Face replacement (external provider; server-side only; pay-as-you-go) ---
# fal-ai/face-swap swaps a face into an IMAGE. Video sources are accepted for upload but refused by this provider.
FACE_PROVIDER=fal
FACE_PROVIDER_API_KEY=
FACE_PROVIDER_MODEL=fal-ai/face-swap
FACE_PROVIDER_BASE_URL=
FACE_POLL_SECONDS=5
# Largest source VIDEO accepted for upload (images use MAX_UPLOAD_MB)
MAX_VIDEO_UPLOAD_MB=100

# --- Plans and payments (Razorpay, India / INR) ---
# Monthly prices in whole rupees. TRAILER is always free. Change them here; the frontend only displays what the API returns.
PLAN_INDIE_PRICE_INR=199
PLAN_BLOCKBUSTER_PRICE_INR=499
# Days of access one successful payment gives.
PLAN_BILLING_DAYS=30
# Create keys at https://dashboard.razorpay.com (use TEST mode keys while developing). Leave empty to switch payments off:
# the app still works, and the Plans page says upgrades aren't available yet.
# RAZORPAY_KEY_ID is public (the browser needs it). The two secrets below must stay on the server only: never commit them.
RAZORPAY_KEY_ID=REPLACE_WITH_RAZORPAY_TEST_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_TEST_SECRET
# Webhook URL to register in Razorpay: https://<your-backend>/api/payments/razorpay/webhook
# (events: payment.captured, order.paid, payment.failed). Use the same secret you type into Razorpay here.
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAY_TEST_WEBHOOK_SECRET
# Payment orders one IP may create per minute (0 disables).
CHECKOUT_RATE_LIMIT_PER_MINUTE=20
